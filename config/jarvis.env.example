# Example only: Jarvis does not automatically load this file.
# Export selected settings in a shell, or use a private systemd EnvironmentFile.
# Keep the source checkout at $HOME/Jarvis; some modules require that location.
JARVIS_MIC_DEVICE=pipewire
JARVIS_WAKE_THRESHOLD=0.50
JARVIS_CONVERSATION_MAX_TURNS=1
JARVIS_COMMAND_SILENCE_SECONDS=0.6
JARVIS_STT_URL=http://127.0.0.1:8178/inference
JARVIS_OLLAMA_URL=http://127.0.0.1:11434/api/chat
JARVIS_AI_MODEL=qwen3.5:0.8b
JARVIS_AI_KEEP_ALIVE=24h
JARVIS_AI_NUM_CTX=1024
JARVIS_AI_MAX_PREDICT=64
JARVIS_ENGINE=piper
JARVIS_LENGTH_SCALE=1.05
JARVIS_SENTENCE_SILENCE=0.2
JARVIS_LEAD_IN_MS=600
# Template stream microphone; installed machine-specific overrides stay local.
JARVIS_STREAM_MIC=default
# JARVIS_LOG_AUDIO_SOURCE=your-local-pipewire-source
# JARVIS_SPOTIFY_CLIENT_ID=your-own-client-id
# JARVIS_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
