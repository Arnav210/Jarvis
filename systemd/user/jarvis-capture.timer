[Unit]
Description=Capture Jarvis room pictures on weekdays every ten minutes from 08:10 to 15:40 Pacific

[Timer]
OnCalendar=Mon..Fri *-*-* 08:10,20,30,40,50:00 America/Los_Angeles
OnCalendar=Mon..Fri *-*-* 09..14:00/10:00 America/Los_Angeles
OnCalendar=Mon..Fri *-*-* 15:00,10,20,30,40:00 America/Los_Angeles
AccuracySec=1s
Persistent=false
Unit=jarvis-capture.service

[Install]
WantedBy=timers.target
