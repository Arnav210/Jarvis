[Unit]
Description=Capture Jarvis room pictures every ten minutes from 08:10 to 15:40 Pacific

[Timer]
OnCalendar=*-*-* 08:10,20,30,40,50:00 America/Los_Angeles
OnCalendar=*-*-* 09..14:00/10:00 America/Los_Angeles
OnCalendar=*-*-* 15:00,10,20,30,40:00 America/Los_Angeles
AccuracySec=1s
Persistent=false
Unit=jarvis-capture.service

[Install]
WantedBy=timers.target
