[Unit]
Requires=jarvis-camera-feed.service
After=jarvis-camera-feed.service
Description=Jarvis remote camera and audio stream
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
Environment=JARVIS_STREAM_MIC=default
ExecStart=/usr/bin/ffmpeg -nostdin -hide_banner -loglevel warning -f mpjpeg -i http://127.0.0.1:8766/stream.mjpg -f pulse -i ${JARVIS_STREAM_MIC} -c:v libx264 -preset ultrafast -tune zerolatency -c:a aac -b:a 128k -f mpegts tcp://0.0.0.0:5000?listen=1
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
