[Unit]
Description=Jarvis Hey Jarvis wake-word listener
After=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/home/toby/Jarvis/.venv-wake/bin/python /home/toby/Jarvis/jarvis_wake.py
Restart=on-failure
RestartSec=5
Nice=5
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=JARVIS_MIC_DEVICE=pipewire
Environment=JARVIS_WAKE_THRESHOLD=0.50

[Install]
WantedBy=default.target
